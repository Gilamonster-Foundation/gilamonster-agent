#!/bin/bash
#
# Pre-push hook for gilamonster-agent
#
# Runs the same lint + test + coverage gates that CI runs, locally, before any
# push reaches origin. If this passes, CI should pass too.
#
# Install: `just install-hooks` (or `git config core.hooksPath .githooks`)
#
# PIPELINE PARITY: this hook mirrors .github/workflows/ci.yml.
#   - SCOPE (Craft Register CRAFT-14 v3.0): the hook is a pre-flight on the
#     changed scope, CI is the full gate. A push with no code change — tags,
#     deletions, or only *.md / docs/ files — skips the gates below with a
#     notice; CI still runs on it.
#   - `just check` matches the lint + test jobs (fmt + clippy + cargo test)
#   - `just cov-ci` matches the coverage job (cargo llvm-cov with the 80% floor)
# When editing this hook, update the workflow to match, and vice-versa.
#
# Do NOT skip this hook with `--no-verify`. If a check fails, fix the issue.
#
# TRANSPORT (newt-agent#276): this gate can outlive GitHub's SSH idle timeout.
# For SSH remotes git opens the connection and reads the advertised refs BEFORE
# running this hook, then sends the pack over that SAME connection afterwards —
# by which time GitHub may have dropped the idle session, and git exits 141
# (SIGPIPE) after the gate passed. `just install-hooks` therefore sets a
# repo-local url."https://github.com/".pushInsteadOf "git@github.com:" so
# pushes transport over HTTPS (a fresh request after the hook) while fetches
# keep their configured URL. HTTPS push auth comes from a git credential
# helper; if pushes prompt for a password, run `gh auth setup-git` once.

set -e

# Read the ref list git writes to the hook's stdin (reading it all also keeps
# git from taking SIGPIPE) and decide whether this push changes any code.
# CRAFT-14: a tag-only, delete-only, or docs-only push skips the gates; CI is
# the full gate on every push regardless.
ZERO=0000000000000000000000000000000000000000
code_change=0
saw_ref=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "$local_sha" ] || continue
    saw_ref=1
    [ "$local_sha" = "$ZERO" ] && continue            # deleting a remote ref
    case "$local_ref" in refs/tags/*) continue ;; esac  # a tag
    if [ "$remote_sha" = "$ZERO" ]; then
        # New branch: measure against where it left main; unknown → run the gates.
        base=$(git merge-base "$local_sha" origin/main 2>/dev/null || true)
    else
        base="$remote_sha"
    fi
    if [ -z "$base" ] || ! git cat-file -e "$base^{commit}" 2>/dev/null; then
        code_change=1
        continue
    fi
    if git diff --name-only "$base" "$local_sha" | grep -qvE '^(docs/|.*\.md$)'; then
        code_change=1
    fi
done
if [ "$saw_ref" = 1 ] && [ "$code_change" = 0 ]; then
    echo "[pre-push] no code change in this push (tag, delete, or docs-only) — gates skipped; CI is the full gate"
    exit 0
fi

cd "$(git rev-parse --show-toplevel)"

# Git exports its hook-time repo environment (GIT_DIR is absolute when pushing
# from a linked worktree) into this process; it leaks into cargo test. Drop the
# leak so the gates see the same world CI does.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

# Ensure ~/.cargo/bin is on PATH so cargo sub-commands resolve even when the
# hook is invoked from an editor/GUI that doesn't source the shell profile.
export PATH="$HOME/.cargo/bin:$PATH"

if ! command -v just >/dev/null 2>&1; then
    echo "pre-push: 'just' not found in PATH"
    echo "          install via: cargo install just"
    exit 1
fi

if ! command -v cargo-llvm-cov >/dev/null 2>&1; then
    echo "pre-push: 'cargo-llvm-cov' not found in PATH"
    echo "          install via: cargo install cargo-llvm-cov"
    exit 1
fi

# Coverage gate: only runs when rustup llvm-tools-preview is available.
# Homebrew Rust ships a different LLVM that reports lower line coverage,
# causing spurious floor failures on macOS Homebrew installs; in that case CI
# (GitHub Actions, rustup) remains the authoritative gate.
SKIP_COV=0
if command -v rustup >/dev/null 2>&1; then
    if ! cargo llvm-cov --version >/dev/null 2>&1; then
        echo "pre-push: rustup is present but llvm-tools-preview is not installed."
        echo "          install via: rustup component add llvm-tools-preview"
        exit 1
    fi
else
    echo "[pre-push] WARNING: rustup not found (Homebrew Rust detected)."
    echo "           Coverage gate skipped locally — CI is the authoritative gate."
    SKIP_COV=1
fi

echo "[pre-push] running just check..."
just check

if [ "$SKIP_COV" -eq 0 ]; then
    echo "[pre-push] running just cov-ci..."
    just cov-ci
fi

echo "[pre-push] OK"
