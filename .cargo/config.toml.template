# Local-dev cargo overlay for gilamonster-agent  (TEMPLATE — copy, don't commit)
# =============================================================================
#
# gila consumes newt-agent over a GIT dependency pinned to a `rev` in
# Cargo.toml (see the [dependencies] block there). That is what CI builds
# against. For LOCAL development against an in-flight newt checkout, copy this
# file to `.cargo/config.toml` (which is git-ignored) and point the paths at
# your local newt-agent tree. Cargo's `[patch]` then transparently swaps the
# git-dep crates for the local path crates — no Cargo.toml edit, no risk of
# committing a path dep.
#
#   cp .cargo/config.toml.template .cargo/config.toml   # or: just overlay-on
#   # edit NEWT below if your checkout lives elsewhere
#   cargo build
#
# Turn it off (CI-equivalent build against the pinned git rev):
#   rm .cargo/config.toml                                # or: just overlay-off
#
# The patch URL MUST match the git dependency's URL in Cargo.toml verbatim,
# and every newt-* crate the dependency tree pulls must be overridden, or
# cargo resolves a mix of git + path and errors. The set below mirrors
# newt-tui's transitive closure (newt-core/-git/-inference/-tools/-skills/
# -mcp-client, plus newt-core's newt-tuner and newt-inference's
# plugins-protocol) plus newt-identity.
#
# Paths are RELATIVE to this repo's root (cargo resolves config paths against
# the directory containing `.cargo/`): a newt-agent checkout as a sibling of
# gilamonster-agent needs no editing. Point them elsewhere if yours differs.

[patch."https://github.com/Gilamonster-Foundation/newt-agent"]
newt-tui         = { path = "../newt-agent/newt-tui" }
newt-identity    = { path = "../newt-agent/newt-identity" }
newt-core        = { path = "../newt-agent/newt-core" }
newt-git         = { path = "../newt-agent/newt-git" }
newt-inference   = { path = "../newt-agent/newt-inference" }
newt-tools       = { path = "../newt-agent/newt-tools" }
newt-skills      = { path = "../newt-agent/newt-skills" }
newt-mcp-client  = { path = "../newt-agent/newt-mcp-client" }
newt-tuner       = { path = "../newt-agent/crates/newt-tuner" }
plugins-protocol = { path = "../newt-agent/plugins-protocol" }

# --- gila-parity Phase 2: pyo3 interpreter pin --------------------------------
# The in-process Python bridge (src/python_bridge.rs) embeds a Python
# interpreter via pyo3. The gila-plugin-* packages are installed EDITABLE into
# ~/venv from ~/workspaces/gilabot; the default `python3` (a pyenv shim) does
# NOT have them importable. So pyo3 must embed ~/venv's interpreter. Pin it
# here (cargo's [env] sets it for the build) — override per-machine if your
# venv lives elsewhere. Without this, pyo3 links the shim and
# `import gilabot` fails at runtime.
#
# Uncomment and adjust for your machine:
# [env]
# PYO3_PYTHON = { value = "../venv/bin/python", relative = false }

